FROM node:20-slim

# Install kimi-code globally
RUN npm install -g @moonshot-ai/kimi-code@0.21.0

# Set up kimi-code config with server password
RUN mkdir -p /root/.kimi-code && \
    kimi config set server_password "VNE1wpc7gqGD1THY-Np6WRPYdU5LlOrk3ICvxsy_N58"

# Expose port
EXPOSE 10000

# Start kimi-code server with host 0.0.0.0 so Render proxy can reach it
# Render health check endpoint is at /health
CMD kimi server run --port ${PORT:-10000} --host --insecure-no-tls --log-level info --allow-remote-terminals --allow-remote-shutdown 2>&1
